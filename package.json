{
  "name": "civic-dashboard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 . && tsc --noEmit",
    "format": "eslint --fix .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:remote": "opennextjs-cloudflare build && opennextjs-cloudflare preview --remote",
    "preview-remote:worker": "opennextjs-cloudflare build && wrangler versions upload",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:update-types": "kysely-codegen --out-file ./src/database/generatedDbTypes.d.ts --url $DATABASE_URL && eslint ./src/database/generatedDbTypes.d.ts --fix",
    "db:create-migration": "kysely migrate:make",
    "db:list-migrations": "kysely migrate:list",
    "db:run-migrations": "kysely migrate:latest && kysely seed:run",
    "db:run-seed": "kysely seed:run",
    "db:start": "docker compose up --detach database",
    "db:stop": "docker compose stop database",
    "docker:start": "docker compose up --detach --wait database",
    "docker:stop": "docker compose stop",
    "tsx": "tsx --tsconfig=tsconfig.tsx.json",
    "tsxe": "tsx --tsconfig=tsconfig.tsx.json --env-file=.env",
    "postbuild": "next-sitemap --config next-sitemap.config.mjs",
    "build:html": "node src/scripts/markdowntohtml.js",
    "dev:html": "npm run build:html && echo 'HTML files generated in public/html'"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "hash-sum": "2.0.0",
    "kysely": "^0.29.4",
    "kysely-postgres-js": "^3.0.0",
    "lucide-react": "^1.14.0",
    "mark.js": "^8.11.1",
    "next": "^16.2.10",
    "next-sitemap": "^4.2.3",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intersection-observer": "^10.0.3",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "sanitize-html": "^2.17.5",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@opennextjs/cloudflare": "^1.19.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/hash-sum": "1.0.2",
    "@types/mark.js": "^8.11.12",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/umami": "^2.10.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sql": "^3.4.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "marked": "^18.0.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "postcss": "^8.5.14",
    "prettier": "3.8.3",
    "react-email": "^6.6.8",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "wrangler": "^4.107.1"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
