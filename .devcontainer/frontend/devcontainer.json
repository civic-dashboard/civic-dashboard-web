{
  "name": "Civic Dashboard (Frontend only)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/civic-dashboard-web",
  "remoteUser": "node",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Civic Dashboard (production proxy)"
    }
  },
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
